<?xml version="1.0" encoding="utf-8"?>
<!--
    tools:ignore="UnusedAttribute" on <application>：enableOnBackInvokedCallback 是 API 33+
    才生效的属性，但它的缺席不等于无害——不声明它，Android 13+ 就会把返回手势交给旧的
    onBackPressed 通路，而 CourseDetailSheet 的返回处理是按新回调写的（见 MANUAL 第七节）。
    所以这是刻意的版本倾斜，不是遗留物。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 教务导入 / 校历 / 调休 数据来自 api.tongji.edu.cn -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 上课提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 注册到系统日历 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".TjApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.TJtimetable"
        tools:ignore="UnusedAttribute">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.TJtimetable">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            今日课程小组件（Glance）。

            exported="false"：APPWIDGET_UPDATE 由 system_server 显式发给本组件，
            系统进程不受 exported 限制，而第三方应用本来就无权给我们发广播。

            Glance 不需要额外的 Service/Activity；手动刷新走的是
            TimetableRefreshAction（ActionCallback，由 Glance 内部的 trampoline 触发）。
        -->
        <receiver
            android:name=".widget.TimetableWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_timetable_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timetable_widget_info" />
        </receiver>
    </application>

</manifest>
