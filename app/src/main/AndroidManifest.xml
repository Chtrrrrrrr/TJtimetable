<?xml version="1.0" encoding="utf-8"?>
<!--
    tools:ignore="UnusedAttribute" on <application>：enableOnBackInvokedCallback 是 API 33+
    才生效的属性，但它的缺席不等于无害——不声明它，Android 13+ 就会把返回手势交给旧的
    onBackPressed 通路，而 CourseDetailSheet 的返回处理是按新回调写的（见 MANUAL 第七节）。
    所以这是刻意的版本倾斜，不是遗留物。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 教务导入 / 校历 / 调休 数据来自 api.tongji.edu.cn -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 上课提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 注册到系统日历 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
        导航页的包可见性声明（Android 11+ 必需）。

        getLaunchIntentForPackage 在未声明的包上一律返回 null，所以没有这段声明，
        「已安装企业微信」会被误判成「未安装」，导航卡片就会给出错误的失败提示。
        下面列出应用商店里已知的包名；浏览器走 ACTION_VIEW，用 <intent> 声明即可。

        最后那条 MAIN/LAUNCHER 的 <intent> 是给「按包名片段兜底查找」用的：
        知到之类的应用在不同版本换过包名，写死包名一旦猜错就会被报成「未安装」，
        而这一条让应用能看见所有带启动图标的包，再按 "zhihuishu" 这类片段匹配。
        它不申请任何权限，也不读取包以外的东西。
    -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.wework" />
        <package android:name="com.chaoxing.mobile" />
        <package android:name="com.chaoxing.ckandroid" />
        <package android:name="com.zhihuishu.zhihuishu" />
        <package android:name="com.zhihuishu.zhidao" />
        <package android:name="com.zhihuishu.student" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TjApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.TJtimetable"
        tools:ignore="UnusedAttribute">

        <!--
            launchMode="singleTop" 不是一个偏好，而是必须的。

            小组件、上课提醒、桌面图标三条路都会 startActivity 打开这里；如果没有这个声明，
            每次点按都会新建一个 Activity 实例叠在原来的上面。学生「从小组件点开 → 回桌面 →
            再点开」就会堆出好几层课表，必须一层层按返回退出——这正是被报告的那个 bug。

            singleTop 让「已经在栈顶」的实例直接复用（走 onNewIntent），而不是再建一个。
            它只影响栈顶复用，不像 singleTask 那样会把别的任务拉进来，所以对返回栈其余部分
            的行为没有副作用。三个入口的 Intent 也都带了 NEW_TASK|CLEAR_TOP|SINGLE_TOP，
            作为双保险：即使将来这里被改回 standard，也不会再出现层叠。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.TJtimetable"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            今日课程小组件（Glance）。

            exported="false"：APPWIDGET_UPDATE 由 system_server 显式发给本组件，
            系统进程不受 exported 限制，而第三方应用本来就无权给我们发广播。

            Glance 不需要额外的 Service/Activity；手动刷新走的是
            TimetableRefreshAction（ActionCallback，由 Glance 内部的 trampoline 触发）。
        -->
        <receiver
            android:name=".widget.TimetableWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_timetable_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timetable_widget_info" />
        </receiver>
    </application>

</manifest>
