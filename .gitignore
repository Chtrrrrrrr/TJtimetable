# =====================================================================
# TJ课表 · TJtimetable
# 原则：只提交"个性化内容"——手写代码 / 构建配置 / 文档 / Room schema。
#       凡是能用标准流程重新下载、或由脚本自动再生的，一律排除。
# =====================================================================

# ---- 自包含工具链（tools/dev/toolchain.ps1 可重建，约 4 GB）----
.toolchain/

# ---- 本机调研/抓取缓存与 agent 过程产物 ----
.probe/
.pae/
.agent-teams/

# ---- 本机真实数据：含姓名/学号/登录态，绝不允许进入版本库 ----
示例.json
*示例*.json
*.local.json
local-*.json
sample-*.json
.env
.env.*

# ---- Gradle / Android 构建产物（可由源码重建）----
.gradle/
.kotlin/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json
mapping.txt
seeds.txt
usage.txt
resources.txt
*.hprof
hs_err_pid*

# ---- 机器相关配置（由 tools/dev/toolchain.ps1 生成）----
local.properties

# ---- 签名与密钥：绝不提交 ----
*.jks
*.keystore
*.p12
*.pem
*.key
keystore.properties
signing.properties
secrets.properties

# ---- IDE / 编辑器 ----
.idea/
*.iml
*.iws
*.ipr
.vscode/

# ---- Node 工具脚本（tools/dev/*.js 为独立脚本，无依赖）----
node_modules/
npm-debug.log*
yarn-error.log*

# ---- 日志与临时/辅助文件 ----
*.log
*.err
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store
